import std.test;
import std.bytes;
import rules;
import safety;
import ik;
import check;

// What the toolbox contract (task #12) must be: the catalogue is the one table (every rule the code emits
// is in it, with an exit code and a summary), the envelope's rule names are the catalogue's tags, and
// introspect's bounds are the safety core's own functions, so nothing is written twice.

fn test_every_rule_the_safety_core_emits_is_in_the_catalogue() -> [] int {
    // safety's rules 1..7 and ik's statuses 1..3 map into the catalogue; ok (0) maps nowhere.
    test.assert(rules.index_of_safety(safety.rule_joint()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_workspace()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_ik_jump()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_collision_tower()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_collision_tray()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_collision_other()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_deadman()) >= 0);
    test.assert(rules.index_of_safety(safety.rule_ok()) < 0);
    test.assert(rules.index_of_ik(ik.status_unreachable()) >= 0);
    test.assert(rules.index_of_ik(ik.status_jump()) >= 0);
    test.assert(rules.index_of_ik(ik.status_limits()) >= 0);
    test.assert(rules.index_of_ik(ik.status_ok()) < 0);
    return 0;
}

fn test_every_safety_rule_and_ik_status_share_a_tag_where_they_share_a_rule() -> [] int {
    // The solver's jump guard and the safety core's ik.jump are the same rule, so the same tag.
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_ik_jump())), rules.tag_of(rules.index_of_ik(ik.status_jump()))));
    return 0;
}

fn test_the_tags_are_the_ones_the_design_names() -> [] int {
    // docs/design.md section 6's table is the contract: a tag may gain siblings, never be repurposed, so
    // the catalogue's tags are pinned here exactly. A rename inside the catalogue alone would leave
    // introspect and the refusals agreeing with each other but lying about the rule they name.
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_joint())), "limit.joint"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_workspace())), "limit.workspace"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_ik_jump())), "ik.jump"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_collision_tower())), "collision.tower"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_collision_tray())), "collision.tray"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_collision_other())), "collision.other"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_safety(safety.rule_deadman())), "deadman"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_ik(ik.status_unreachable())), "ik.unreachable"));
    test.assert(bytes.equal(rules.tag_of(rules.index_of_ik(ik.status_limits())), "ik.limits"));
    return 0;
}

fn test_the_catalogue_has_args_rules_and_they_exit_two() -> [] int {
    // args.unknown-command is index 10, args.malformed 11 (the order is stable; introspect lists it).
    test.assert(bytes.equal(rules.tag_of(10), "args.unknown-command"));
    test.assert(bytes.equal(rules.tag_of(11), "args.malformed"));
    test.assert_eq(rules.exit_of(10), 2);
    test.assert_eq(rules.exit_of(11), 2);
    return 0;
}

fn test_every_entry_has_four_fields_and_a_known_exit() -> [] int {
    var i = 0;
    while i < rules.count() {
        test.assert(len(rules.tag_of(i)) > 0);
        let exit = rules.exit_of(i);
        test.assert(exit == 2 || exit == 8);
        test.assert(len(rules.summary_of(i)) > 0);
        i = i + 1;
    }
    return 0;
}

fn test_the_schema_and_version_are_stable() -> [] int {
    test.assert(bytes.equal(check.schema(), "check.v1"));
    test.assert(bytes.equal(check.version(), "0.1.0"));
    return 0;
}
