edition 7;
import std.io;
import ik;
import kinematics;
import so101;

// A test driver for `tests/differential_ik.py`: `ik.solve` behind a pipe. One line per request:
//
//     solve <q0..q4> <x> <y> <z>     the live joint state in degrees, the target in metres (the arm's own
//                                    frame), each as its 64 float bits
//
// Answers one line of nine integers: the status, the iterations, then the five solution angles' bits.
// Standard input and output, nothing else.

fn token[&l, &s](line: &l [byte], k: int, span: &!s [int]) -> [] bool {
    var i = 0;
    var seen = -1;
    let n = len(line);
    while i < n {
        while i < n && int_of(line[i]) == ' ' {
            i = i + 1;
        }
        if i >= n {
            return false;
        }
        let start = i;
        while i < n && int_of(line[i]) != ' ' {
            i = i + 1;
        }
        seen = seen + 1;
        if seen == k {
            span[0] = start;
            span[1] = i;
            return true;
        }
    }
    return false;
}

fn number[&l, &s](line: &l [byte], k: int, span: &!s [int]) -> [] int {
    if !token(line, k, span) {
        return 0;
    }
    var i = span[0];
    var negative = false;
    if int_of(line[i]) == '-' {
        negative = true;
        i = i + 1;
    }
    var v = 0;
    while i < span[1] {
        v = v * 10 - (int_of(line[i]) - '0');
        i = i + 1;
    }
    if negative {
        return v;
    }
    return -v;
}

fn answer[&i, &l](io: &!i Io, line: &l [byte]) -> [io_write] int {
    region a {
        let span = alloc_slice[a](2, 0);
        // `step <q0..q4> <x> <y> <z>`: one damped least squares step from the state, the joints it proposes
        // (the differential's Jacobian comparison against placo's single solve()).
        if int_of(line[0]) == 's' && int_of(line[1]) == 't' {
            let current = alloc_slice[a](5, 0.0);
            let target = alloc_slice[a](3, 0.0);
            let dq = alloc_slice[a](5, 0.0);
            let work = alloc_slice[a](61, 0.0);
            var k = 0;
            while k < 5 {
                current[k] = float_of_bits(number(line, 1 + k, span));
                k = k + 1;
            }
            target[0] = float_of_bits(number(line, 6, span));
            target[1] = float_of_bits(number(line, 7, span));
            target[2] = float_of_bits(number(line, 8, span));
            let pose = alloc_slice[a](16, 0.0);
            kinematics.forward(current, pose);
            let before = alloc_slice[a](16, 0.0);
            var c = 0;
            while c < 16 {
                before[c] = pose[c];
                c = c + 1;
            }
            let err = sqrt((target[0] - pose[3]) * (target[0] - pose[3]) + (target[1] - pose[7]) * (target[1] - pose[7]) + (target[2] - pose[11]) * (target[2] - pose[11]));
            var lam = 0.001;
            let scaled = 0.05 * err;
            if scaled > lam {
                lam = scaled;
            }
            if ik.one_step(current, target, dq, work, lam) != 0 {
                io.print_int(io, 0);
                io.newline(io);
                return 0;
            }
            var j = 0;
            while j < 5 {
                if j > 0 {
                    putchar(io, ' ');
                }
                io.print_int(io, bits_of(dq[j]));
                j = j + 1;
            }
            io.newline(io);
            return 0;
        }
        let current = alloc_slice[a](5, 0.0);
        let target = alloc_slice[a](3, 0.0);
        let solution = alloc_slice[a](5, 0.0);
        let error_m = alloc_slice[a](1, 0.0);
        let iterations = alloc_slice[a](1, 0);
        var k = 0;
        while k < 5 {
            current[k] = float_of_bits(number(line, 1 + k, span));
            k = k + 1;
        }
        target[0] = float_of_bits(number(line, 6, span));
        target[1] = float_of_bits(number(line, 7, span));
        target[2] = float_of_bits(number(line, 8, span));
        let limits = alloc_slice[a](10, 0.0);
        limits_of(limits);
        let status = ik.solve(current, target, solution, limits, error_m, iterations);
        io.print_int(io, status);
        putchar(io, ' ');
        io.print_int(io, iterations[0]);
        var j = 0;
        while j < 5 {
            putchar(io, ' ');
            io.print_int(io, bits_of(solution[j]));
            j = j + 1;
        }
        io.newline(io);
    }
    return 0;
}

// The measured joint spans of the left arm's calibration file (tests/fixtures/calibration/xle_left.json),
// in the degrees calibration.degrees reports.
fn limits_of[&l](l: &!l [float]) -> [] int {
    l[0] = -113.2;
    l[1] = 113.2;
    l[2] = -90.5;
    l[3] = 90.5;
    l[4] = -95.4;
    l[5] = 95.4;
    l[6] = -75.3;
    l[7] = 75.3;
    l[8] = -180.0;
    l[9] = 180.0;
    return 0;
}

fn run[&i](io: &!i Io) -> [io_read, io_write] int {
    var more = true;
    while more {
        region a {
            let line = alloc_slice[a](256, byte_of(0));
            var n = 0;
            var c = getchar(io);
            while c >= 0 && c != '\n' {
                if n < len(line) {
                    line[n] = byte_of(c);
                    n = n + 1;
                }
                c = getchar(io);
            }
            if c < 0 && n == 0 {
                more = false;
            } else {
                answer(io, line[0..n]);
            }
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(net);
    release(clock);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(signals);
    release(exec);
    var status = 0;
    borrow mut io as &!i in {
        status = run(i);
    }
    release(io);
    return status;
}
