edition 5;
module rules;

// `rules` -- the controller's rule catalogue (task #12), in the toolbox contract's shape (cancho-tools
// `contract/rules.cho`, D5): one table, `tag|exit|repairable|summary`, read by the code that answers a
// refusal AND by `introspect`, so the two cannot disagree.
//
// The tags are the ones the code emits, unchanged: the safety core's (src/safety.cho) and the solver's
// (src/ik.cho) carry theirs, and a refusal a caller reads names the same rule a gate fixed. The argument
// and shape rules are this tool's own (a line the controller cannot parse is refused with a tag, like
// everything else).
//
// One entry per rule, in a stable order; the order is the order `introspect` lists them.

import std.bytes;

pub fn catalogue() -> [] &static [byte] {
    return "limit.joint|8|never|a requested angle is outside the joint's measured span;limit.workspace|8|never|the gripper would leave the workspace bound, in the arm's own frame;ik.jump|8|never|a joint would move further than the gripper's travel justifies;collision.tower|8|never|the arm's capsules would hit the tower;collision.tray|8|never|the arm's capsules would hit the cart tray's box;collision.other|8|never|the arm's capsules would hit the other arm;limit.speed|8|never|the gripper would exceed the speed limit, clamped and reported;deadman|8|never|no fresh request within the bound, so the arm holds;ik.unreachable|8|never|the solver could not put the gripper at the target;ik.limits|8|never|the solver's answer would leave the measured spans;args.unknown-command|2|never|a line whose first word names no command;args.malformed|2|never|a line the controller cannot parse into its command's shape";
}

pub fn count() -> [] int {
    return bytes.count_byte(catalogue(), ';') + 1;
}

// Entry `i` (0-based), whole.
pub fn entry(i: int) -> [] &static [byte] {
    return bytes.field(catalogue(), ';', i + 1);
}

pub fn tag_of(i: int) -> [] &static [byte] {
    return bytes.field(entry(i), '|', 1);
}

pub fn exit_of(i: int) -> [] int {
    var n = 0;
    let f = bytes.field(entry(i), '|', 2);
    var k = 0;
    while k < len(f) {
        n = n * 10 + (int_of(f[k]) - '0');
        k = k + 1;
    }
    return n;
}

pub fn repairable_of(i: int) -> [] &static [byte] {
    return bytes.field(entry(i), '|', 3);
}

pub fn summary_of(i: int) -> [] &static [byte] {
    return bytes.field(entry(i), '|', 4);
}

// The catalogue's index of a rule the code emits, or -1. The code emits ints (`safety.rule_joint` and
// friends); this maps them once, so the JSON names the tag.
pub fn index_of_safety(rule: int) -> [] int {
    if rule == 1 {
        return 0;
    } // limit.joint
    if rule == 2 {
        return 1;
    } // limit.workspace
    if rule == 3 {
        return 2;
    } // ik.jump
    if rule == 4 {
        return 3;
    } // collision.tower
    if rule == 5 {
        return 4;
    } // collision.tray
    if rule == 6 {
        return 5;
    } // collision.other
    if rule == 7 {
        return 7;
    } // deadman
    return -1; // 0 is ok, not a rule
}

pub fn index_of_ik(status: int) -> [] int {
    if status == 1 {
        return 8;
    } // ik.unreachable
    if status == 2 {
        return 2;
    } // ik.jump (the solver's own guard, the same tag)
    if status == 3 {
        return 9;
    } // ik.limits
    return -1; // 0 is ok
}
