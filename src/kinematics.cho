edition 5;

module kinematics;

import std.math;
import so101;

// `kinematics` -- forward kinematics of the SO-101, from the chain `so101` generated from the URDF. Task #7; gate C4
// of docs/design.md section 8 holds it to placo (through LeRobot's `RobotKinematics`, the solver lex-robot uses).
//
// The URDF convention, as placo reads it: a joint's frame is its parent's, moved by the origin's translation `xyz`,
// then turned by the origin's `rpy` (R = Rz(yaw) Ry(pitch) Rx(roll)), then turned about its own z axis by the joint
// angle. The pose of `gripper_frame_link` in `base_link`'s frame is the product along the chain.
//
// Angles come in as LeRobot reports them, degrees, and are converted the way numpy's `deg2rad` does: one multiply by
// pi / 180. Everything is pure: a 4x4 matrix, row-major, written into the caller's 16 floats.

fn pi() -> [] float {
    return 3.141592653589793;
}

// numpy.deg2rad: x * (pi / 180), the constant folded first.
pub fn radians(degrees: float) -> [] float {
    return degrees * (pi() / 180.0);
}

fn identity[&m](m: &!m [float]) -> [] int {
    var i = 0;
    while i < 16 {
        m[i] = 0.0;
        i = i + 1;
    }
    m[0] = 1.0;
    m[5] = 1.0;
    m[10] = 1.0;
    m[15] = 1.0;
    return 0;
}

// m = m * t, both 4x4 row-major; `scratch` holds 16 floats.
fn times[&m, &t, &s](m: &!m [float], t: &t [float], scratch: &!s [float]) -> [] int {
    var r = 0;
    while r < 4 {
        var c = 0;
        while c < 4 {
            var sum = 0.0;
            var k = 0;
            while k < 4 {
                sum = sum + m[r * 4 + k] * t[k * 4 + c];
                k = k + 1;
            }
            scratch[r * 4 + c] = sum;
            c = c + 1;
        }
        r = r + 1;
    }
    var i = 0;
    while i < 16 {
        m[i] = scratch[i];
        i = i + 1;
    }
    return 0;
}

// The transform of chain element `k` at joint angle `q` radians (0 for the fixed one): translation, rpy, then Rz(q).
fn element[&t](k: int, q: float, t: &!t [float]) -> [] int {
    let cr = math.cos(so101.rpy(k, 0));
    let sr = math.sin(so101.rpy(k, 0));
    let cp = math.cos(so101.rpy(k, 1));
    let sp = math.sin(so101.rpy(k, 1));
    let cy = math.cos(so101.rpy(k, 2));
    let sy = math.sin(so101.rpy(k, 2));
    // R = Rz(yaw) Ry(pitch) Rx(roll)
    let r00 = cy * cp;
    let r01 = cy * sp * sr - sy * cr;
    let r02 = cy * sp * cr + sy * sr;
    let r10 = sy * cp;
    let r11 = sy * sp * sr + cy * cr;
    let r12 = sy * sp * cr - cy * sr;
    let r20 = -sp;
    let r21 = cp * sr;
    let r22 = cp * cr;
    // then Rz(q): columns 0 and 1 turn, column 2 stays
    let cq = math.cos(q);
    let sq = math.sin(q);
    t[0] = r00 * cq + r01 * sq;
    t[1] = r01 * cq - r00 * sq;
    t[2] = r02;
    t[3] = so101.xyz(k, 0);
    t[4] = r10 * cq + r11 * sq;
    t[5] = r11 * cq - r10 * sq;
    t[6] = r12;
    t[7] = so101.xyz(k, 1);
    t[8] = r20 * cq + r21 * sq;
    t[9] = r21 * cq - r20 * sq;
    t[10] = r22;
    t[11] = so101.xyz(k, 2);
    t[12] = 0.0;
    t[13] = 0.0;
    t[14] = 0.0;
    t[15] = 1.0;
    return 0;
}

// The pose of `gripper_frame_link` for the five joint angles in `degrees` (shoulder_pan, shoulder_lift, elbow_flex,
// wrist_flex, wrist_roll), into `pose` (16 floats, row-major; the position is pose[3], pose[7], pose[11]). Answers 0,
// or -1 if `degrees` has fewer than five angles or `pose` fewer than sixteen places.
pub fn forward[&d, &p](degrees: &d [float], pose: &!p [float]) -> [] int {
    if len(degrees) < so101.moving() || len(pose) < 16 {
        return -1;
    }
    region a {
        let t = alloc_slice[a](16, 0.0);
        let scratch = alloc_slice[a](16, 0.0);
        identity(pose);
        var k = 0;
        while k < so101.transforms() {
            var q = 0.0;
            if k < so101.moving() {
                q = radians(degrees[k]);
            }
            element(k, q, t);
            times(pose, t, scratch);
            k = k + 1;
        }
    }
    return 0;
}

// The origin of every link frame in the chain, in base_link's frame, for the five joint angles in `degrees`: the
// capsule model's skeleton. `points` holds 3 floats per frame, `so101.transforms() + 1` frames (base_link's origin
// first, at 0 0 0), so 21 floats for this chain. Answers 0, or -1 if the slices are too small.
pub fn frames[&d, &p](degrees: &d [float], points: &!p [float]) -> [] int {
    if len(degrees) < so101.moving() || len(points) < (so101.transforms() + 1) * 3 {
        return -1;
    }
    region a {
        let t = alloc_slice[a](16, 0.0);
        let scratch = alloc_slice[a](16, 0.0);
        let m = alloc_slice[a](16, 0.0);
        identity(m);
        points[0] = 0.0;
        points[1] = 0.0;
        points[2] = 0.0;
        var k = 0;
        while k < so101.transforms() {
            var q = 0.0;
            if k < so101.moving() {
                q = radians(degrees[k]);
            }
            element(k, q, t);
            times(m, t, scratch);
            var i = 0;
            while i < 16 {
                m[i] = scratch[i];
                i = i + 1;
            }
            points[(k + 1) * 3] = m[3];
            points[(k + 1) * 3 + 1] = m[7];
            points[(k + 1) * 3 + 2] = m[11];
            k = k + 1;
        }
    }
    return 0;
}
