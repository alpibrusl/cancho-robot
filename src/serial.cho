edition 5;

module serial;

import feetech;
import libc;

// `serial` -- the servo bus as a file descriptor: open it raw at 1,000,000 baud, send one packet, collect one
// status packet. Linux only (the controller is the Raspberry Pi 5, docs/decisions.md); the darwin variant is the
// spike's (spikes/ping/ping.cho: the speed needs the variadic IOSSIOSPEED ioctl there).
//
// **Every foreign call to the bus is made here** (docs/design.md section 3); the declarations are `libc`'s: `cancho authority`
// reports them symbol by symbol, and a gate pins the list. Nothing here builds a packet; it moves the bytes the
// codec built, so whether a program can write to a servo is decided by whether it imports `feetech_write`, not
// by this module.
//
// What the FFI allows shaped it (research log, 2026-10-08): a `&[byte]` crosses to C as a pointer AND a length,
// so `open(path, flags)` takes the `c_ptr` that `strdup` answers, and `read`/`write` line up with C's
// (fd, buffer, count) exactly; `cfsetspeed` would take the length as the speed, so the speed is written into the
// termios bytes; `free` cannot be declared (the runtime declares it), so the one copy of the path is not freed.
// The termios layout is glibc 2.41 aarch64's, measured by spikes/ping/abi_linux.c.

// ── glibc 2.41, aarch64 (spikes/ping/abi_linux.c) ────────────────────────────────────────────────────────────

fn o_rdwr() -> [] int {
    return 2;
}

fn o_noctty() -> [] int {
    return 256;
}

fn o_nonblock() -> [] int {
    return 2048;
}

fn termios_size() -> [] int {
    return 60;
}

fn cflag_at() -> [] int {
    return 8;
}

fn cc_at() -> [] int {
    return 17;
}

fn ispeed_at() -> [] int {
    return 52;
}

fn ospeed_at() -> [] int {
    return 56;
}

fn vmin() -> [] int {
    return 6;
}

fn vtime() -> [] int {
    return 5;
}

fn clocal() -> [] int {
    return 2048;
}

fn cread() -> [] int {
    return 128;
}

fn cbaud_mask() -> [] int {
    return 4111;
} // CBAUD, 010017

fn b1000000() -> [] int {
    return 4104;
} // B1000000, 010010

fn tciflush() -> [] int {
    return 0;
}

fn clock_monotonic() -> [] int {
    return 1;
}

// ── results ──────────────────────────────────────────────────────────────────────────────────────────────────
// Below the codec's own error codes (-1 .. -6), so a caller can tell the bus from the bytes.

// No complete status packet within the timeout: the servo did not answer (or answered too little).
pub fn error_timeout() -> [] int {
    return -20;
}

// `write` took fewer bytes than the packet.
pub fn error_write() -> [] int {
    return -21;
}

// The reply buffer filled without a complete packet in it.
pub fn error_overflow() -> [] int {
    return -22;
}

// The path is not NUL-terminated, or the device would not open or configure.
pub fn error_open() -> [] int {
    return -23;
}

pub fn error_tag(code: int) -> [] &static [byte] {
    if code == error_timeout() {
        return "serial.timeout";
    }
    if code == error_write() {
        return "serial.write";
    }
    if code == error_overflow() {
        return "serial.overflow";
    }
    if code == error_open() {
        return "serial.open";
    }
    return feetech.error_tag(code);
}

// Little-endian unsigned field of `n` bytes.
fn get_le[&b](t: &b [byte], at: int, n: int) -> [] int {
    var v = 0;
    var i = n - 1;
    while i >= 0 {
        v = v * 256 + int_of(t[at + i]);
        i = i - 1;
    }
    return v;
}

fn put_le[&b](t: &!b [byte], at: int, n: int, value: int) -> [] int {
    var v = value;
    var i = 0;
    while i < n {
        t[at + i] = byte_of(v % 256);
        v = v / 256;
        i = i + 1;
    }
    return 0;
}

// ── the clock ────────────────────────────────────────────────────────────────────────────────────────────────

// The monotonic clock in microseconds. cancho's `clock_ms` is a millisecond clock; a servo answers in a third of
// one, so the bus is timed here, through the same libc the bus already uses.
pub fn now_us[&f](ffi: &f Ffi("libc")) -> [ffi("libc")] int {
    var us = 0;
    region a {
        let ts = alloc_slice[a](16, byte_of(0));
        libc.clock_gettime(ffi, clock_monotonic(), ts);
        us = get_le(ts, 0, 8) * 1000000 + get_le(ts, 8, 8) / 1000;
    }
    return us;
}

// Sleep for `us` microseconds: the console's pacing between steps, never inside a transaction.
pub fn sleep_us[&f](ffi: &f Ffi("libc"), us: int) -> [ffi("libc")] int {
    libc.usleep(ffi, us);
    return 0;
}

// ── the bus ──────────────────────────────────────────────────────────────────────────────────────────────────

// Open `path` (which must end in a NUL byte) raw at 1,000,000 baud, non-blocking. Answers the descriptor, or
// `error_open()`.
pub fn open_bus[&f, &p](ffi: &f Ffi("libc"), path: &p [byte]) -> [ffi("libc")] int {
    let n = len(path);
    if n < 2 || int_of(path[n - 1]) != 0 {
        return error_open();
    }
    let fd = libc.open(ffi, libc.strdup(ffi, path), o_rdwr() + o_noctty() + o_nonblock());
    if fd < 0 {
        return error_open();
    }
    var ok = true;
    region a {
        let t = alloc_slice[a](termios_size(), byte_of(0));
        if libc.tcgetattr(ffi, fd, t) != 0 {
            ok = false;
        } else {
            libc.cfmakeraw(ffi, t);
            let cf = get_le(t, cflag_at(), 4);
            put_le(t, cflag_at(), 4, cf & ~cbaud_mask() | b1000000() | clocal() | cread());
            t[cc_at() + vmin()] = byte_of(0);
            t[cc_at() + vtime()] = byte_of(0);
            // glibc 2.41 keeps the B-constant in these two fields too (measured: 4104 after cfsetspeed).
            put_le(t, ispeed_at(), 4, b1000000());
            put_le(t, ospeed_at(), 4, b1000000());
            if libc.tcsetattr(ffi, fd, 0, t) != 0 {
                ok = false;
            } else {
                // Read back what the driver kept: the speed bits must be B1000000, or the bus is silent.
                let back = alloc_slice[a](termios_size(), byte_of(0));
                libc.tcgetattr(ffi, fd, back);
                if get_le(back, cflag_at(), 4) & cbaud_mask() != b1000000() {
                    ok = false;
                }
            }
        }
    }
    if !ok {
        libc.close(ffi, fd);
        return error_open();
    }
    return fd;
}

pub fn close_bus[&f](ffi: &f Ffi("libc"), fd: int) -> [ffi("libc")] int {
    return libc.close(ffi, fd);
}

// Send `pkt[0..n]` and collect the status packet from `expected_id` into `reply`, for up to `timeout_us`.
// Anything waiting on the input side is dropped first (a late answer to an earlier request must not be read as
// this one's). Answers what `feetech.decode` answers for the bytes (the packet's end, with `table` filled, or a
// codec error), or one of this module's errors. Polls without sleeping: a reply takes a third of a millisecond,
// and the finest sleep would cost more than the wait.
pub fn transact[&f, &p, &r, &t](ffi: &f Ffi("libc"), fd: int, pkt: &p [byte], n: int, reply: &!r [byte], expected_id: int, table: &!t [int], timeout_us: int) -> [ffi("libc")] int {
    libc.tcflush(ffi, fd, tciflush());
    if libc.write(ffi, fd, pkt[0..n]) != n {
        return error_write();
    }
    let start = now_us(ffi);
    var got = 0;
    while true {
        if got >= len(reply) {
            return error_overflow();
        }
        let k = libc.read(ffi, fd, reply[got..len(reply)]);
        if k > 0 {
            got = got + k;
            let r = feetech.decode(reply[0..got], expected_id, table);
            if r != feetech.need_more() {
                return r;
            }
        }
        if now_us(ffi) - start > timeout_us {
            return error_timeout();
        }
    }
    return error_timeout();
}

// Send `pkt[0..n]` and expect no answer: SYNC WRITE and broadcast instructions, which no servo acknowledges. What
// the bytes are is decided by whoever built them; the only builders of write instructions are in
// `feetech_write`, and the only caller of this is `serial_write` (gate A3).
pub fn send[&f, &p](ffi: &f Ffi("libc"), fd: int, pkt: &p [byte], n: int) -> [ffi("libc")] int {
    if libc.write(ffi, fd, pkt[0..n]) != n {
        return error_write();
    }
    return n;
}
