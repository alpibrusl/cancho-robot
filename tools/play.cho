edition 5;

import std.io;
import core;
import robot;
import serial;
import safety;

// `play` -- the playground: a console that drives the arms through the safety core, one command at a time.
//
//     play            the robot's two buses (an operator at the e-stop: this moves the arms)
//     play --sim      the simulated bus, sim/fake_bus.py (nothing real moves)
//
// Commands (sides: l or r; joints: pan lift elbow wrist roll grip; angles in degrees, the gripper in percent):
//
//     read                       both arms, and whether each holds torque
//     torque <side> on           hold where the arm is, then torque on (the goal is set first: no jump)
//     torque <side> off          torque off: the arm falls where gravity takes it
//     move <side> <joint> <d>    move a joint by d, in steps of at most 2 degrees every 20 ms, every step
//                                through core.commit; stops at the first refusal, and on a stall
//     check <side> <joint> <d>   what the safety core would answer for that move, sending nothing
//     help, quit
//
// Each bus is recognised by its servos' calibration (core.identify), not by its path. The program imports `core`
// for motion and nothing else that writes; its authority ceiling is authority/play.ceiling.

fn say[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    return io.write_all(io, text);
}

// A float with one decimal: -12.3
fn print_fixed[&i](io: &!i Io, x: float) -> [io_write] int {
    var v = x;
    if v < 0.0 {
        say(io, "-");
        v = 0.0 - v;
    }
    let tenths = truncate(v * 10.0 + 0.5);
    io.print_int(io, tenths / 10);
    say(io, ".");
    io.print_int(io, tenths % 10);
    return 0;
}

// ── a line and its words ─────────────────────────────────────────────────────────────────────────────────────

// Read one line into `line` (without the newline). Answers its length, or -1 at the end of input.
fn read_line[&i, &l](io: &!i Io, line: &!l [byte]) -> [io_read] int {
    var n = 0;
    while true {
        let c = getchar(io);
        if c < 0 {
            if n == 0 {
                return -1;
            }
            return n;
        }
        if c == 10 {
            return n;
        }
        if n < len(line) {
            line[n] = byte_of(c);
            n = n + 1;
        }
    }
    return n;
}

// The k-th word of `line[0..n]`, as [start, end) into `span`. Answers false if there is none.
fn word[&l, &s](line: &l [byte], n: int, k: int, span: &!s [int]) -> [] bool {
    var i = 0;
    var seen = -1;
    while i < n {
        while i < n && int_of(line[i]) == ' ' {
            i = i + 1;
        }
        if i >= n {
            return false;
        }
        let start = i;
        while i < n && int_of(line[i]) != ' ' {
            i = i + 1;
        }
        seen = seen + 1;
        if seen == k {
            span[0] = start;
            span[1] = i;
            return true;
        }
    }
    return false;
}

fn is[&l, &s, &w](line: &l [byte], span: &s [int], text: &w [byte]) -> [] bool {
    if span[1] - span[0] != len(text) {
        return false;
    }
    var i = 0;
    while i < len(text) {
        if int_of(line[span[0] + i]) != int_of(text[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// A decimal number like -2.5 or +10, into `out[0]`. Answers false if the word is not one.
fn number[&l, &s, &o](line: &l [byte], span: &s [int], out: &!o [float]) -> [] bool {
    var i = span[0];
    var negative = false;
    if i < span[1] && (int_of(line[i]) == '-' || int_of(line[i]) == '+') {
        negative = int_of(line[i]) == '-';
        i = i + 1;
    }
    var v = 0.0;
    var digits = 0;
    while i < span[1] && int_of(line[i]) >= '0' && int_of(line[i]) <= '9' {
        v = v * 10.0 + float_of(int_of(line[i]) - '0');
        digits = digits + 1;
        i = i + 1;
    }
    if i < span[1] && int_of(line[i]) == '.' {
        i = i + 1;
        var place = 0.1;
        while i < span[1] && int_of(line[i]) >= '0' && int_of(line[i]) <= '9' {
            v = v + place * float_of(int_of(line[i]) - '0');
            place = place / 10.0;
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits == 0 || i != span[1] {
        return false;
    }
    if negative {
        v = 0.0 - v;
    }
    out[0] = v;
    return true;
}

fn side_of[&l, &s](line: &l [byte], span: &s [int]) -> [] int {
    if is(line, span, "l") || is(line, span, "left") {
        return robot.left();
    }
    if is(line, span, "r") || is(line, span, "right") {
        return robot.right();
    }
    return -1;
}

fn joint_of[&l, &s](line: &l [byte], span: &s [int]) -> [] int {
    if is(line, span, "pan") {
        return 0;
    }
    if is(line, span, "lift") {
        return 1;
    }
    if is(line, span, "elbow") {
        return 2;
    }
    if is(line, span, "wrist") {
        return 3;
    }
    if is(line, span, "roll") {
        return 4;
    }
    if is(line, span, "grip") {
        return 5;
    }
    return -1;
}

fn joint_name(j: int) -> [] &static [byte] {
    if j == 0 {
        return "pan";
    }
    if j == 1 {
        return "lift";
    }
    if j == 2 {
        return "elbow";
    }
    if j == 3 {
        return "wrist";
    }
    if j == 4 {
        return "roll";
    }
    if j == 5 {
        return "grip";
    }
    return "-";
}

fn side_name(side: int) -> [] &static [byte] {
    if side == robot.left() {
        return "left";
    }
    return "right";
}

// ── the state: per side, its bus, whether it holds torque, and the held pose ─────────────────────────────────
// fds[side] (-1 when no bus carries that side), torque[side] (0/1), held[side * 6 + j].

fn print_arm[&i, &u](io: &!i Io, side: int, units: &u [float], torque: int) -> [io_write] int {
    say(io, side_name(side));
    var j = 0;
    while j < robot.joints() {
        say(io, "  ");
        say(io, joint_name(j));
        say(io, " ");
        print_fixed(io, units[j]);
        j = j + 1;
    }
    if torque == 1 {
        say(io, "  torque on\n");
    } else {
        say(io, "  torque off\n");
    }
    return 0;
}

fn refusal[&i](io: &!i Io, rule: int, joint: int) -> [io_write] int {
    say(io, "  refused: ");
    say(io, core.rule_name(rule));
    if joint >= 0 {
        say(io, " (");
        say(io, joint_name(joint));
        say(io, ")");
    }
    say(io, "\n");
    return 0;
}

// The other arm's five joint angles into `other`, or an empty answer (0) when it has no bus.
fn other_arm[&f, &d, &o](ffi: &f Ffi("libc"), fds: &d [int], side: int, other: &!o [float]) -> [ffi("libc")] int {
    let o = 1 - side;
    if fds[o] < 0 {
        return 0;
    }
    var n = 0;
    region a {
        let units = alloc_slice[a](robot.joints(), 0.0);
        if core.read_arm(ffi, fds[o], o, units) == 0 {
            var j = 0;
            while j < robot.gripper() {
                other[j] = units[j];
                j = j + 1;
            }
            n = robot.gripper();
        }
    }
    return n;
}

fn toward(from: float, to: float, step: float) -> [] float {
    if to > from + step {
        return from + step;
    }
    if to < from - step {
        return from - step;
    }
    return to;
}

fn clamp_lead(value: float, present: float, most: float) -> [] float {
    if value > present + most {
        return present + most;
    }
    if value < present - most {
        return present - most;
    }
    return value;
}

// Move `side` to `target` (six values), every 20 ms one step through core.commit. The HELD pose is what was
// requested, not the speed-clamped goal the core wrote, so the joints that are not moving stay where they were
// asked to be (a goal recomputed from the present position lets gravity walk a joint down: lex-robot#215); each
// request leads the present position by at most the core's lead bound. Stops when every request has reached its target
// and the arm is within a degree of it, or within 3 and no longer getting closer (the remaining error is printed);
// on a refusal, on a bus error, or on a stall: a second without the remaining error shrinking, the
// arm then held where it stopped, so it does not keep pushing against whatever holds it.
fn run_move[&f, &i, &d, &h, &t](ffi: &f Ffi("libc"), io: &!i Io, fds: &d [int], side: int, held: &!h [float], target: &t [float]) -> [ffi("libc"), io_write] int {
    let fd = fds[side];
    var result = 0;
    region a {
        let present = alloc_slice[a](robot.joints(), 0.0);
        let request = alloc_slice[a](robot.joints(), 0.0);
        let goals = alloc_slice[a](robot.joints(), 0.0);
        let other5 = alloc_slice[a](robot.gripper(), 0.0);
        let joint = alloc_slice[a](1, -1);
        let base = side * robot.joints();
        var cycles = 0;
        var best = 1000000.0;
        var since_better = 0;
        var done = false;
        while !done && cycles < 1000 {
            if core.read_arm(ffi, fd, side, present) != 0 {
                say(io, "  bus error: stopped\n");
                result = core.rule_bus();
                done = true;
            } else {
                // The remaining error, and whether it is still shrinking.
                var error = 0.0;
                var k = 0;
                while k < robot.joints() {
                    var d = present[k] - target[k];
                    if d < 0.0 {
                        d = 0.0 - d;
                    }
                    if d > error {
                        error = d;
                    }
                    k = k + 1;
                }
                if error < best - 0.2 {
                    best = error;
                    since_better = 0;
                } else {
                    since_better = since_better + 1;
                }
                let n = other_arm(ffi, fds, side, other5);
                // Arrived: every request at its target, and the arm either within a degree of it or no longer
                // getting closer (a servo under load settles a little short; how short is reported, not hidden).
                var asked = true;
                var r = 0;
                while r < robot.joints() {
                    if held[base + r] != target[r] {
                        asked = false;
                    }
                    r = r + 1;
                }
                if asked && (error <= 1.0 || error <= 3.0 && since_better >= 25) {
                    say(io, "  done, ");
                    print_fixed(io, error);
                    say(io, " from the target\n");
                    done = true;
                } else if since_better >= 50 {
                    say(io, "  stalled: a joint is held back; holding where it is\n");
                    let rule = core.commit(ffi, fd, side, present, present, present, other5[0..n], 0, 20, goals, joint);
                    if rule == safety.rule_ok() {
                        var c = 0;
                        while c < robot.joints() {
                            held[base + c] = present[c];
                            c = c + 1;
                        }
                    } else {
                        refusal(io, rule, joint[0]);
                    }
                    result = -1;
                    done = true;
                } else {
                    var j = 0;
                    while j < robot.joints() {
                        var step = 2.0;
                        var most = core.lead_deg();
                        if j == robot.gripper() {
                            step = 5.0;
                            most = core.lead_percent();
                        }
                        request[j] = clamp_lead(toward(held[base + j], target[j], step), present[j], most);
                        j = j + 1;
                    }
                    let rule = core.commit(ffi, fd, side, request, present, held[base..base + robot.joints()], other5[0..n], 0, 20, goals, joint);
                    if rule != safety.rule_ok() {
                        refusal(io, rule, joint[0]);
                        result = rule;
                        done = true;
                    } else {
                        // Held: the goals written, which advance from the last ones (core.commit), so a joint that
                        // is not moving keeps its goal and one that is gets there at the commanded speed.
                        var c = 0;
                        while c < robot.joints() {
                            held[base + c] = goals[c];
                            c = c + 1;
                        }
                        serial.sleep_us(ffi, 20000);
                    }
                }
            }
            cycles = cycles + 1;
        }
        if !done {
            say(io, "  timed out: holding the last goal\n");
        }
        print_arm(io, side, present, 1);
    }
    return result;
}

fn help[&i](io: &!i Io) -> [io_write] int {
    say(io, "commands: read | torque <l|r> on|off | move <l|r> <joint> <d> | check <l|r> <joint> <d> | quit\n");
    say(io, "joints: pan lift elbow wrist roll grip (degrees; grip in percent)\n");
    return 0;
}

fn console[&f, &i, &d, &q, &h](ffi: &f Ffi("libc"), io: &!i Io, fds: &d [int], torque: &!q [int], held: &!h [float]) -> [ffi("libc"), io_read, io_write] int {
    region a {
        let line = alloc_slice[a](256, byte_of(0));
        let span = alloc_slice[a](2, 0);
        let value = alloc_slice[a](1, 0.0);
        let units = alloc_slice[a](robot.joints(), 0.0);
        let target = alloc_slice[a](robot.joints(), 0.0);
        while true {
            say(io, "> ");
            let n = read_line(io, line);
            if n < 0 {
                return 0;
            }
            if !word(line, n, 0, span) {
                say(io, "");
            } else if is(line, span, "quit") || is(line, span, "exit") {
                return 0;
            } else if is(line, span, "help") {
                help(io);
            } else if is(line, span, "read") {
                var s = 0;
                while s < 2 {
                    if fds[s] >= 0 {
                        if core.read_arm(ffi, fds[s], s, units) == 0 {
                            print_arm(io, s, units, torque[s]);
                        } else {
                            say(io, side_name(s));
                            say(io, ": bus error\n");
                        }
                    }
                    s = s + 1;
                }
            } else {
                let verb_torque = is(line, span, "torque");
                let verb_move = is(line, span, "move");
                let verb_check = is(line, span, "check");
                var side = -1;
                if word(line, n, 1, span) {
                    side = side_of(line, span);
                }
                if !verb_torque && !verb_move && !verb_check {
                    help(io);
                } else if side < 0 {
                    say(io, "  which side? l or r\n");
                } else if fds[side] < 0 {
                    say(io, "  no bus carries that arm\n");
                } else if verb_torque {
                    if word(line, n, 2, span) && is(line, span, "on") {
                        if core.hold_and_enable(ffi, fds[side], side, units) == 0 {
                            torque[side] = 1;
                            var j = 0;
                            while j < robot.joints() {
                                held[side * robot.joints() + j] = units[j];
                                j = j + 1;
                            }
                            print_arm(io, side, units, 1);
                        } else {
                            say(io, "  bus error: torque unchanged\n");
                        }
                    } else if word(line, n, 2, span) && is(line, span, "off") {
                        if core.free_arm(ffi, fds[side], side) == 0 {
                            torque[side] = 0;
                            say(io, "  torque off: the arm is free\n");
                        } else {
                            say(io, "  bus error\n");
                        }
                    } else {
                        say(io, "  torque <l|r> on|off\n");
                    }
                } else {
                    var joint = -1;
                    if word(line, n, 2, span) {
                        joint = joint_of(line, span);
                    }
                    var ok = joint >= 0 && word(line, n, 3, span);
                    if ok {
                        ok = number(line, span, value);
                    }
                    if !ok {
                        say(io, "  move|check <l|r> <pan|lift|elbow|wrist|roll|grip> <amount>\n");
                    } else if core.read_arm(ffi, fds[side], side, units) != 0 {
                        say(io, "  bus error\n");
                    } else {
                        // From the held pose when torque is on (the goal is what moves), else from where it is.
                        var j = 0;
                        while j < robot.joints() {
                            if torque[side] == 1 {
                                target[j] = held[side * robot.joints() + j];
                            } else {
                                target[j] = units[j];
                            }
                            j = j + 1;
                        }
                        target[joint] = target[joint] + value[0];
                        if verb_check {
                            let other5 = alloc_slice[a](robot.gripper(), 0.0);
                            let k = other_arm(ffi, fds, side, other5);
                            let limits = alloc_slice[a](robot.gripper() * 2, 0.0);
                            core.limits_of(side, limits);
                            let goals = alloc_slice[a](robot.gripper(), 0.0);
                            let scale = alloc_slice[a](1, 0.0);
                            let jj = alloc_slice[a](1, -1);
                            let m = core.mount_of(side);
                            var rule = 0;
                            borrow m as &mm in {
                                rule = safety.approve(target, target, limits, mm, other5[0..k], 0, 20, goals, scale, jj);
                            }
                            if rule == safety.rule_ok() {
                                say(io, "  approved: the pose is inside every bound\n");
                            } else {
                                refusal(io, rule, jj[0]);
                            }
                        } else if torque[side] != 1 {
                            refusal(io, core.rule_torque_off(), -1);
                        } else {
                            run_move(ffi, io, fds, side, held, target);
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn run[&f, &i, &g](ffi: &f Ffi("libc"), io: &!i Io, args: &g Args) -> [ffi("libc"), io_read, io_write, args] int {
    var sim = false;
    if arg_count(args) > 1 {
        let a1 = arg(args, 1);
        sim = len(a1) == 5 && int_of(a1[2]) == 's' && int_of(a1[3]) == 'i' && int_of(a1[4]) == 'm';
        if !sim {
            say(io, "usage: play [--sim]\n");
            return 2;
        }
    }
    var status = 0;
    region a {
        let fds = alloc_slice[a](2, -1);
        let torque = alloc_slice[a](2, 0);
        let held = alloc_slice[a](2 * robot.joints(), 0.0);
        let opened = alloc_slice[a](robot.devices(), -1);
        var k = 0;
        while k < robot.devices() {
            var path = robot.device(k);
            if sim {
                path = robot.sim_device(k);
            }
            let fd = serial.open_bus(ffi, path);
            opened[k] = fd;
            say(io, "bus ");
            say(io, path[0..len(path) - 1]);
            if fd < 0 {
                say(io, ": cannot open\n");
            } else {
                let side = core.identify(ffi, fd);
                if side < 0 {
                    say(io, ": its servos match neither calibration; not driven\n");
                } else if fds[side] >= 0 {
                    say(io, ": a second bus with the same arm; not driven\n");
                } else {
                    fds[side] = fd;
                    say(io, ": the ");
                    say(io, side_name(side));
                    say(io, " arm (its servos carry that calibration)\n");
                }
            }
            k = k + 1;
        }
        help(io);
        status = console(ffi, io, fds, torque, held);
        var c = 0;
        while c < robot.devices() {
            if opened[c] >= 0 {
                serial.close_bus(ffi, opened[c]);
            }
            c = c + 1;
        }
    }
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(net);
    release(clock);
    release(fs);
    release(heap);
    let libc = narrow(ffi, "libc");
    var status = 0;
    borrow libc as &f in {
        borrow args as &g in {
            borrow mut io as &!i in {
                status = run(f, i, g);
            }
        }
    }
    release(libc);
    release(args);
    release(io);
    return status;
}
